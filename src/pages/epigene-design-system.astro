---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import CardSection from "../components/CardSection.astro";
import AuditTour from "../components/AuditTour.astro";
import Icon from "../components/Icon.astro";

/* Audit walkthrough: the analysis flow in 2022, notes taken from the Figma audit.
   pin = [x, y] and spot = [left, top, width, height], in % of the screenshot (2000×1200).
   \u00a0 = non-breaking space before French punctuation. */
const auditScreens = [
  {
    src: "/assets/design-system-audit-01-analysis-list.webp",
    alt: "mCUBE in 2022: the My analyses page, empty except for a Create new Analysis card",
    eyebrowEn: "Start",
    eyebrowFr: "Départ",
    titleEn: "The analysis list",
    titleFr: "La liste des analyses",
    notes: [
      {
        pin: [27, 21.3],
        spot: [6, 21.3, 21.3, 21.7],
        theme: "guide",
        titleEn: `An empty state that doesn't guide`,
        titleFr: `Un état vide qui ne guide pas`,
        textEn: `The first screen shows a single card on an empty page, with no word on what an analysis is or where to start. It's the moment a new user needs guidance most, and the interface says nothing.`,
        textFr: `Le premier écran affiche une seule carte sur une page vide, sans un mot sur ce qu'est une analyse ni par où commencer. C'est le moment où un nouvel utilisateur a le plus besoin d'être guidé, et l'interface ne dit rien.`,
      },
    ],
  },
  {
    src: "/assets/design-system-audit-02-cohort-start.webp",
    alt: "Step 1 in 2022: data elements to drag and drop into an empty cohort zone",
    eyebrowEn: "Step 1 · Cohort",
    eyebrowFr: "Étape 1 · Cohorte",
    titleEn: "Building the cohort",
    titleFr: "Construire la cohorte",
    notes: [
      {
        pin: [27, 15.2],
        spot: [4.5, 11, 45, 8.5],
        theme: "guide",
        titleEn: `No sense of progress`,
        titleFr: `Aucun repère de progression`,
        textEn: `The analysis runs over several steps, but no stepper or breadcrumb shows them. Users can't tell where they are or what's left.`,
        textFr: `L'analyse se fait en plusieurs étapes, sans stepper ni fil d'Ariane pour les montrer\u00a0: l'utilisateur ne sait ni où il en est, ni ce qu'il reste.`,
      },
      {
        pin: [48, 24],
        spot: [5, 19.5, 43, 20],
        theme: "experience",
        titleEn: `Drag and drop as the only way in`,
        titleFr: `Le glisser-déposer comme seule option`,
        textEn: `Picking filters is a simple selection, yet dragging is the only way to add one: extra effort, and no way in for keyboard users.`,
        textFr: `Choisir des filtres est une simple sélection, pourtant glisser est le seul moyen d'en ajouter\u00a0: un effort en plus, et aucun accès au clavier.`,
      },
      {
        pin: [87.5, 79.3],
        spot: [89, 76.8, 6.2, 5.2],
        theme: "guide",
        titleEn: `A button label that says nothing`,
        titleFr: `Un libellé qui ne dit rien`,
        textEn: `"Validate" doesn't say what comes next. A label should describe the outcome, like "Continue to rules".`,
        textFr: `«\u00a0Validate\u00a0» n'annonce pas la suite. Un libellé doit décrire le résultat de l'action, comme «\u00a0Continue to rules\u00a0».`,
      },
    ],
  },
  {
    src: "/assets/design-system-audit-03-cohort-selection.webp",
    alt: "Step 1 in 2022: two filters dropped into the cohort, next to the data element table",
    eyebrowEn: "Step 1 · Cohort",
    eyebrowFr: "Étape 1 · Cohorte",
    titleEn: "Picking values",
    titleFr: "Choisir les valeurs",
    notes: [
      {
        pin: [94.5, 18.5],
        spot: [51.5, 18.5, 43, 44.5],
        theme: "guide",
        titleEn: `No feedback on changes`,
        titleFr: `Aucun retour sur les changements`,
        textEn: `The panel on the right doesn't react as the cohort is built, and nothing explains its role. Users can't tell if their choices worked.`,
        textFr: `Le panneau de droite ne réagit pas quand la cohorte se construit, et rien n'explique son rôle\u00a0: l'utilisateur ne sait pas si ses choix sont pris en compte.`,
      },
      {
        pin: [25.3, 42.6],
        spot: [23.8, 45.6, 3, 4.4],
        theme: "system",
        titleEn: `A remove icon that reads as an error`,
        titleFr: `Une icône de suppression lue comme une erreur`,
        textEn: `A red X signals an error or a permanent deletion. The choice leaves room for interpretation and creates confusion.`,
        textFr: `Un X rouge évoque une erreur ou une suppression définitive. Ce choix laisse place à l'interprétation et sème la confusion.`,
      },
      {
        pin: [54, 62.5],
        spot: [51.5, 22.5, 5, 40],
        theme: "guide",
        titleEn: `Details behind an arrow`,
        titleFr: `Des détails derrière une flèche`,
        textEn: `Each data element's details hide behind an arrow, so checking the cohort takes extra clicks for what should be visible at a glance.`,
        textFr: `Le détail de chaque data element est caché derrière une flèche\u00a0: vérifier la cohorte demande des clics en plus pour l'essentiel.`,
      },
    ],
  },
  {
    src: "/assets/design-system-audit-04-cohort-full.webp",
    alt: "Step 1 in 2022: a cohort filled with filters, with a large empty space above it",
    eyebrowEn: "Step 1 · Cohort",
    eyebrowFr: "Étape 1 · Cohorte",
    titleEn: "A cohort with many filters",
    titleFr: "Une cohorte avec beaucoup de filtres",
    notes: [
      {
        pin: [49, 64],
        spot: [5, 40, 44, 48],
        theme: "experience",
        titleEn: `A layout that doesn't scale`,
        titleFr: `Une structure qui ne tient pas la charge`,
        textEn: `The drop zone grows with every filter and pushes "Validate" off the screen, making the button unreachable.`,
        textFr: `La zone de dépôt grandit à chaque filtre et pousse «\u00a0Validate\u00a0» hors de l'écran, rendant le bouton inaccessible.`,
      },
      {
        pin: [27, 30.5],
        spot: [5, 21.5, 44.5, 18],
        theme: "experience",
        titleEn: `Gaps left behind`,
        titleFr: `Des trous laissés derrière`,
        textEn: `Every element dragged into the cohort leaves an empty space in the list above. The screen looks broken while the user is working.`,
        textFr: `Chaque élément glissé dans la cohorte laisse un espace vide dans la liste du dessus. L'écran semble cassé pendant que l'utilisateur travaille.`,
      },
    ],
  },
  {
    src: "/assets/design-system-audit-05-rules-list.webp",
    alt: "Step 2 in 2022: an empty rule list with a single Create new Rule card and a collapsed side tab",
    eyebrowEn: "Step 2 · Rules",
    eyebrowFr: "Étape 2 · Règles",
    titleEn: "The rule list",
    titleFr: "La liste des règles",
    notes: [
      {
        pin: [23, 25.5],
        spot: [5.5, 25.5, 17.5, 18],
        theme: "guide",
        titleEn: `An empty state with no direction`,
        titleFr: `Un état vide sans direction`,
        textEn: `Step 2 opens on a single "Create new Rule" card surrounded by unused space. Nothing says what a rule is or why the analysis needs one.`,
        textFr: `L'étape 2 s'ouvre sur une seule carte « Create new Rule », entourée d'espace inutilisé. Rien n'explique ce qu'est une règle ni pourquoi l'analyse en a besoin.`,
      },
      {
        pin: [92.5, 15],
        spot: [94.5, 11.8, 3.3, 6.2],
        theme: "guide",
        titleEn: `A summary out of sight`,
        titleFr: `Un récapitulatif hors de vue`,
        textEn: `The analysis summary hides behind a small, unlabeled toggle. Users have to remember their settings instead of seeing them.`,
        textFr: `Le récapitulatif de l'analyse est caché derrière un petit toggle sans libellé. L'utilisateur doit se souvenir de ses réglages au lieu de les voir.`,
      },
    ],
  },
  {
    src: "/assets/design-system-audit-06-rule-creation.webp",
    alt: "Step 2 in 2022: the Add a rule modal, with a switch, scoring options and a boxplot",
    eyebrowEn: "Step 2 · Rules",
    eyebrowFr: "Étape 2 · Règles",
    titleEn: "Adding a rule",
    titleFr: "Ajouter une règle",
    notes: [
      {
        pin: [85, 18.5],
        spot: [15, 18.5, 70, 64.5],
        theme: "system",
        titleEn: `A modal for a full task`,
        titleFr: `Une modale pour une tâche complète`,
        textEn: `Modals suit short, focused dialogs. This one holds a full setup with a chart: it breaks the flow and hides the context needed to decide.`,
        textFr: `Une modale convient à un échange court. Celle-ci porte toute une configuration et un graphique\u00a0: elle coupe le parcours et masque le contexte.`,
      },
      {
        pin: [43, 46.2],
        spot: [17, 43, 25, 6.5],
        theme: "system",
        titleEn: `A switch used the wrong way`,
        titleFr: `Un switch à contre-emploi`,
        textEn: `This switch chooses between two options, which is what radio buttons are for. Its label is also a negative: "No, make this rule unique".`,
        textFr: `Ce switch sert à choisir entre deux options, alors que c'est le rôle des boutons radio. Son libellé est une négation\u00a0: «\u00a0No, make this rule unique\u00a0».`,
      },
      {
        pin: [80.5, 65],
        spot: [47.5, 55, 33, 10],
        theme: "system",
        titleEn: `A selection that looks disabled`,
        titleFr: `Une sélection qui semble désactivée`,
        textEn: `The selected range on the boxplot is gray, the color of disabled: the interface sends the opposite signal of what the user just did.`,
        textFr: `Sur le boxplot, la zone sélectionnée est grise, la couleur du désactivé\u00a0: l'interface envoie le signal inverse de l'action de l'utilisateur.`,
      },
    ],
  },
  {
    src: "/assets/design-system-audit-07-results.webp",
    alt: "Step 2 in 2022: a computed analysis with a rule edited inline and the summary panel collapsed",
    eyebrowEn: "Step 2 · Rules",
    eyebrowFr: "Étape 2 · Règles",
    titleEn: "The results",
    titleFr: "Les résultats",
    notes: [
      {
        pin: [82, 54.4],
        spot: [83.5, 52.8, 11.5, 3.4],
        theme: "guide",
        titleEn: `The main action, styled as a detail`,
        titleFr: `L'action principale traitée comme un détail`,
        textEn: `"Compute indication score" is what the whole flow leads to, yet it's a small text link on the side, with none of the weight of a primary action.`,
        textFr: `«\u00a0Compute indication score\u00a0», le but du parcours, n'est qu'un petit lien texte sur le côté, sans le poids d'une action principale.`,
      },
      {
        pin: [37, 23.3],
        spot: [21.3, 23, 15.5, 17.5],
        theme: "system",
        titleEn: `Two patterns for one object`,
        titleFr: `Deux patterns pour un même objet`,
        textEn: `Rules are created in a modal but edited inline in a card, with different controls: one object, two behaviors to learn.`,
        textFr: `Une règle se crée dans une modale mais se modifie dans une carte, avec d'autres contrôles\u00a0: un objet, deux comportements à apprendre.`,
      },
      {
        pin: [11.5, 40.8],
        spot: [4.6, 16.5, 32.4, 26],
        theme: "system",
        titleEn: `No button hierarchy`,
        titleFr: `Aucune hiérarchie de boutons`,
        textEn: `Filled green, outlined, red text, icon links: nothing sets primary, secondary and destructive apart, and placement changes across screens.`,
        textFr: `Vert plein, encadré, texte rouge, lien avec icône\u00a0: rien ne distingue principal, secondaire et destructif, et leur place change selon l'écran.`,
      },
    ],
  },
  {
    src: "/assets/design-system-audit-08-saving.webp",
    alt: "Step 2 in 2022: the computed analysis with the blue summary panel open",
    eyebrowEn: "Step 2 · Rules",
    eyebrowFr: "Étape 2 · Règles",
    titleEn: "Saving the analysis",
    titleFr: "Enregistrer l'analyse",
    notes: [
      {
        pin: [90, 16.2],
        spot: [92, 14.3, 5, 3.8],
        theme: "experience",
        titleEn: `A key action that feels optional`,
        titleFr: `Une action clé qui semble optionnelle`,
        textEn: `Save sits inside the summary panel, which can be collapsed. Far from the work, an action users need all the time looks optional, with a real risk of losing work.`,
        textFr: `Save est placé dans le panneau récapitulatif, qui peut être replié. Loin du travail en cours, une action très sollicitée paraît optionnelle, avec un vrai risque de perdre son travail.`,
      },
      {
        pin: [81, 32],
        spot: [81, 11, 16.7, 42.5],
        theme: "experience",
        titleEn: `Text that's hard to read`,
        titleFr: `Un texte difficile à lire`,
        textEn: `Small white text on light blue barely stands out from its background. It's tiring for everyone, and out of reach for people with low vision.`,
        textFr: `Le texte blanc, en petite taille, sur fond bleu clair se détache à peine du fond. Il rend lecture difficile voir illisible.`,
      },
    ],
  },
];
---

<Layout
  title="Design System | Epigene Labs | Célia Lafond"
  description="Building mCUBE's first design system at Epigene Labs, from a UI/UX audit to a complete, scalable system shared across Figma and code."
>
  <div class="cs-page">
    <div class="cs-page-hero">
      <a href="/" class="cs-back">
        <svg viewBox="0 0 24 24"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
        <span class="en">Work</span>
        <span class="fr">Projets</span>
      </a>
      <h1 class="cs-page-title reveal">
        <span class="en"
          >Building mCUBE's first design system,<br />from audit to code</span
        >
        <span class="fr"
          >Construire le premier design system de mCUBE,<br />de l'audit au code</span
        >
      </h1>
      <p class="cs-page-company reveal">Epigene Labs &middot; 2022 – 2026</p>

      <div class="cs-hero-image reveal">
        <img
          src="/assets/cover-design-system.webp"
          alt="mCUBE: Design System"
          onerror="this.parentElement.innerHTML='<div class=&quot;cs-img-placeholder&quot;>mCUBE: Design System</div>'"
        />
      </div>
      <div class="cs-hero-summary reveal">
        <div class="cs-summary-col">
          <Card
            titleEn="Product"
            titleFr="Produit"
            legendEn="mCUBE's Design System"
            legendFr="Le Design System de mCUBE"
            textEn="mCUBE is a genomic data analysis platform for oncology researchers. It was built by engineers, with no designer and no design decisions documented anywhere. I led the redesign from a UI audit to a full design system, implemented directly in the codebase."
            textFr="mCUBE est une plateforme d'analyse de données génomiques pour les chercheurs en oncologie. Elle a été construite par des ingénieurs, sans designer et sans aucune décision de design documentée. J'ai piloté la refonte, d'un audit UI jusqu'à un design system complet, implémenté directement dans la codebase."
          />
          <Card titleEn="Details" titleFr="Détails">
            <CardSection
              textEn="Product Designer ∙ Frontend Engineer"
              captionEn="Role"
              captionFr="Rôle"
            />
            <CardSection
              textEn="Figma ∙ React.js ∙ ReScript"
              captionEn="Tools / Stack"
              captionFr="Outils / Stack"
            />
            <CardSection
              textEn="1 product designer & front-end engineer (me) ∙ VP & CTO as stakeholders"
              textFr="1 designeuse & développeuse front-end (moi) ∙ VP & CTO comme parties prenantes"
              captionEn="Team"
              captionFr="Équipe"
            />
            <CardSection
              textEn="UX/UI Audit ∙ Design Systems ∙ Component Architecture"
              textFr="Audit UX/UI ∙ Design Systems ∙ Architecture de composants"
              captionEn="Scope"
            />
          </Card>
        </div>
        <div class="cs-summary-col">
          <Card>
            <CardSection
              titleEn="Problem"
              titleFr="Problème"
              textEn="An interface never designed for the people using it: no landmarks in the flows, primary actions hidden, no feedback, and components that behaved differently from one screen to the next."
              textFr="Une interface jamais pensée pour ses utilisateurs : pas de repères dans les parcours, des actions principales cachées, aucun feedback, et des composants incohérents d'un écran à l'autre."
            />
            <CardSection
              titleEn="Solution"
              titleFr="Solution"
              textEn="I built a complete design system from scratch: colors, typography, spacing, components, grid. Then I redesigned the product around it, implementing it directly in the front-end to keep design and code in sync."
              textFr="J'ai construit un design system complet de zéro : couleurs, typographie, espacement, composants, grille. Puis j'ai redesigné le produit autour de cette base, en l'implémentant directement en front-end pour garder design et code alignés."
            />
            <CardSection
              titleEn="Result"
              titleFr="Résultat"
              textEn={`Design became a selling point. Users described the product as "user-friendly", and the term went into every marketing post and into pitches to leading biopharma organizations, alongside cloud architecture and data coverage. A rare differentiator in a field where design is often an afterthought.`}
              textFr="Le design est devenu un argument commercial. Les utilisateurs qualifiaient le produit de « user-friendly », et le terme s'est retrouvé dans tous les posts marketing et dans les pitchs destinés aux grandes organisations biopharma, aux côtés de l'architecture cloud et de la couverture data. Un vrai différenciant dans un milieu où le design passe souvent au second plan."
            />
          </Card>
        </div>
      </div>
    </div>
    <main class="cs-main">
      <section class="cs-section reveal" id="context">
        <h2 class="cs-section-heading">
          <span class="en">Context</span>
          <span class="fr">Contexte</span>
        </h2>
        <div class="grid-2 items-baseline">
          <p class="cs-section-heading-legend">
            <span class="en">
              Epigene Labs is a <span class="text-accent">biotech startup</span> specializing
              in <span class="text-accent">precision oncology</span>.
            </span>
            <span class="fr">
              Epigene Labs est une <span class="text-accent"
                >startup de la biotech</span
              >, spécialisée en
              <span class="text-accent">oncologie de précision</span>.
            </span>
          </p>
          <div>
            <p class="en">
              It puts genomic data to work for cancer research. How? Through
              mCUBE, a genomic data analysis platform for oncology researchers.
              In 2022, the product was in its early days: a single type of
              analysis, one client, a handful of users. I was brought in to
              rethink the interface, which had never been designed by a
              designer.
            </p>
            <p class="fr">
              Elle met la donnée génomique au service de la recherche contre le
              cancer. Comment ? À travers mCUBE, une plateforme d'analyse de
              données génomiques destinée aux chercheurs en oncologie. En 2022,
              le produit en était à ses débuts : un seul type d'analyse, un
              client, une poignée d'utilisateurs. J'ai été chargée de repenser
              l'interface, qui n'avait jamais été pensée par un designer.
            </p>
          </div>
        </div>
      </section>

      <section class="cs-section reveal" id="problem">
        <h2 class="cs-section-heading">
          <span class="en">Problem</span>
          <span class="fr">Problème</span>
        </h2>
        <div class="cs-section-content">
          <div class="grid-2 items-baseline">
            <p class="cs-section-heading-legend">
              <span class="en">
                A solid product, but <span class="text-accent"
                  >no foundation</span
                > to build its interfaces on.
              </span>
              <span class="fr">
                Un produit solide, mais <span class="text-accent"
                  >sans base</span
                > pour construire ses interfaces.
              </span>
            </p>
            <div>
              <p class="en">
                mCUBE was built by engineers responding to requests from
                leadership, with the VP acting as the link to the business and
                the clients. Two things were missing: a product team to
                structure needs and gather the users' voice, and a shared system
                to frame the interfaces. Without that foundation, every screen
                went its own way.
              </p>
              <p class="fr">
                mCUBE était construit par des ingénieurs qui répondaient aux
                demandes de la hiérarchie, le VP faisant le lien avec le
                business et les clients. Il manquait deux choses : une équipe
                produit pour structurer les besoins et recueillir la voix des
                utilisateurs, et un système partagé pour cadrer les interfaces.
                Sans cette base, chaque écran avançait de son côté.
              </p>
            </div>
          </div>
          <!-- Before screenshots, hidden while the audit walkthrough is in progress
          <div
            class="cs-img-wrapper cs-img-grid cs-img-grid-2"
            data-slider-mobile
          >
            <div class="cs-img">
              <img
                loading="lazy"
                decoding="async"
                src="/assets/design-system-problem-before-1.webp"
                alt="UI Audit epigene labs"
                onerror='this.parentElement.innerHTML=&apos;<div class="cs-img-placeholder" style="aspect-ratio:4/3">UI Audit</div>&apos;'
              />
            </div>
            <div class="cs-img">
              <img
                loading="lazy"
                decoding="async"
                src="/assets/design-system-problem-before-2.webp"
                alt="UI Audit epigene labs"
                onerror='this.parentElement.innerHTML=&apos;<div class="cs-img-placeholder" style="aspect-ratio:4/3">UI Audit</div>&apos;'
              />
            </div>
            <div class="cs-img">
              <img
                loading="lazy"
                decoding="async"
                src="/assets/design-system-problem-before-3.webp"
                alt="UI Audit epigene labs"
                onerror='this.parentElement.innerHTML=&apos;<div class="cs-img-placeholder" style="aspect-ratio:4/3">UI Audit</div>&apos;'
              />
            </div>
            <div class="cs-img">
              <img
                loading="lazy"
                decoding="async"
                src="/assets/design-system-problem-before-4.webp"
                alt="UI Audit epigene labs"
                onerror='this.parentElement.innerHTML=&apos;<div class="cs-img-placeholder" style="aspect-ratio:4/3">UI Audit</div>&apos;'
              />
            </div>
          </div>
          -->
        </div>
      </section>

      <section class="cs-section reveal" id="audit">
        <div class="cs-section-content">
          <h2 class="cs-section-heading-legend text-align-center">
            <span class="en"
              ><span class="text-accent">Auditing</span> what was there</span
            >
            <span class="fr"
              ><span class="text-accent">Auditer</span> l'existant</span
            >
          </h2>
          <div>
            <p class="en text-align-center">
              Before designing anything, I ran a UI/UX audit of the product, to
              lay out screen by screen what was getting in users' way.
            </p>
            <p class="fr text-align-center">
              Avant de concevoir quoi que ce soit, j'ai mené un audit UI/UX du
              produit, pour mettre à plat, écran par écran, ce qui freinait les
              utilisateurs.
            </p>
          </div>
          <div class="cs-subsections">
            <div class="flex flex-col gap-2">
              <h3 class="cs-subsection-subheading">
                <span class="en">One flow, problems found everywhere</span>
                <span class="fr"
                  >Un parcours, des problèmes présents partout</span
                >
              </h3>
              <p class="en">
                An excerpt from the audit: creating an analysis, from the empty
                list to the results. These problems weren't isolated, the same
                ones came back across the rest of the app. Each point is tagged
                with the kind of problem it reveals.
              </p>
              <p class="fr">
                Un extrait de l'audit&nbsp;: la création d'une analyse, de la
                liste vide jusqu'aux résultats. Ces problèmes n'étaient pas
                isolés, les mêmes revenaient dans le reste de l'application.
                Chaque point est associé au type de problème qu'il révèle.
              </p>
              <AuditTour
                labelEn="Creating an analysis in 2022"
                labelFr="Créer une analyse en 2022"
                screens={auditScreens}
              />
            </div>
            <!-- What the audit revealed: two causes lead to one consequence -->
            <div class="flex flex-col gap-4">
              <div class="flex flex-col gap-2">
                <h3 class="cs-subsection-subheading text-align-center">
                  <span class="en">What the audit revealed</span>
                  <span class="fr">Ce que l'audit a révélé</span>
                </h3>
                <p class="text-align-center">
                  <span class="en"
                    >With no system to guarantee consistency and usability, the
                    same flaws came back from one screen to the next.</span
                  >
                  <span class="fr"
                    >Faute de système garantissant cohérence et ergonomie, les
                    mêmes failles revenaient d'un écran à l'autre.</span
                  >
                </p>
              </div>
              <div class="flex flex-col gap-1">
                <div class="cs-cards cs-cards-2">
                  <Card variant="hollow">
                    <div class="flex flex-col gap-1">
                      <div class="flex flex-col gap-0 items-start">
                        <span class="cs-ds-tour-tag">
                          <span class="en">No system</span>
                          <span class="fr">Aucun système</span>
                        </span>
                        <p class="card-heading">
                          <span class="en"
                            >No system, inconsistencies everywhere</span
                          >
                          <span class="fr"
                            >Aucun système, des incohérences partout</span
                          >
                        </p>
                      </div>
                      <p class="body-sm">
                        <span class="en"
                          >Without shared rules, every screen made its own
                          choices. The same gray could mean "selected" here and
                          "disabled" there, buttons moved from one page to the
                          next, and components like the switch or the modal were
                          used against their purpose.</span
                        >
                        <span class="fr"
                          >Sans règles partagées, chaque écran faisait ses
                          propres choix. Un même gris pouvait signifier
                          «&nbsp;sélectionné&nbsp;» ici et
                          «&nbsp;désactivé&nbsp;» là, les boutons changeaient de
                          place d'une page à l'autre, et des composants comme le
                          switch ou la modale étaient détournés de leur usage.</span
                        >
                      </p>
                    </div>
                  </Card>
                  <Card variant="hollow">
                    <div class="flex flex-col gap-1">
                      <div class="flex flex-col gap-0 items-start">
                        <span class="cs-ds-tour-tag">
                          <span class="en">Didn't guide</span>
                          <span class="fr">Ne guidait pas</span>
                        </span>
                        <p class="card-heading">
                          <span class="en">An interface that didn't guide</span>
                          <span class="fr"
                            >Une interface qui ne guidait pas</span
                          >
                        </p>
                      </div>
                      <p class="body-sm">
                        <span class="en"
                          >The interface rarely told users what was happening:
                          changes didn't show on screen, loading gave no sign of
                          progress, and the main action stayed hidden. With no
                          clear labels or help along the way, people moved
                          forward without bearings, at the risk of losing their
                          work.</span
                        >
                        <span class="fr"
                          >L'interface disait rarement à l'utilisateur ce qui se
                          passait&nbsp;: les changements ne s'affichaient pas,
                          les chargements ne donnaient aucun signe d'avancement
                          et l'action principale restait cachée. Sans libellés
                          clairs ni aide en chemin, il avançait sans repères, au
                          risque de perdre son travail.</span
                        >
                      </p>
                    </div>
                  </Card>
                </div>
                <div class="cs-ds-findings-link">
                  <svg
                    class="cs-ds-findings-link-arrow"
