---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/icons";

const cells = Array.from({ length: 100 }, (_, i) => i);

const steps: {
  icon: IconName;
  en: { title: string; text: string };
  fr: { title: string; text: string };
}[] = [
  {
    icon: "database",
    en: {
      title: "A new data strategy",
      text: "The company chose to open its whole database, unreviewed datasets included.",
    },
    fr: {
      title: "Une nouvelle stratégie data",
      text: "L'entreprise choisit d'ouvrir toute sa base, datasets non validés compris.",
    },
  },
  {
    icon: "speechBubble",
    en: {
      title: "User interviews",
      text: "Understand how researchers searched for and chose datasets in the V1 explorer.",
    },
    fr: {
      title: "Interviews utilisateurs",
      text: "Comprendre comment les chercheurs cherchaient et choisissaient leurs datasets dans le Data Explorer V1.",
    },
  },
  {
    icon: "group",
    en: {
      title: "Cross-team workshop",
      text: "Align product, engineering and scientific teams on what mattered most.",
    },
    fr: {
      title: "Workshop transverse",
      text: "Aligner produit, ingénierie et équipes scientifiques sur les priorités.",
    },
  },
  {
    icon: "layout",
    en: {
      title: "The redesign",
      text: "Rethink the Data Explorer for the new scale of the database.",
    },
    fr: {
      title: "La refonte",
      text: "Repenser le Data Explorer pour la nouvelle échelle de la base.",
    },
  },
];
---

<Layout
  title="Data Explorer Redesign | Epigene Labs | Célia Lafond"
  description="How I redesigned the Data Explorer at Epigene Labs to surface 20,000+ datasets and align the interface with a new data strategy."
>
  <div class="cs-page">
    <div class="cs-page-hero">
      <a href="/" class="cs-back">
        <svg viewBox="0 0 24 24"
          ><polyline points="15 18 9 12 15 6"></polyline></svg
        >
        <span class="en">Work</span>
        <span class="fr">Projets</span>
      </a>
      <h1 class="cs-page-title reveal">
        <span class="en"
          >Redesigning the Data Explorer to handle 10× more datasets, from 2,000
          to 20,000+</span
        >
        <span class="fr"
          >Repenser le Data Explorer pour accueillir 10 fois plus de datasets,
          de 2&nbsp;000 à plus de 20&nbsp;000</span
        >
      </h1>
      <p class="cs-page-company reveal">Epigene Labs &middot; 2025</p>
      <div class="cs-hero-image reveal">
        <img
          src="/assets/cover-data-explorer.webp"
          alt="Data Explorer: redesigned interface"
          onerror="this.parentElement.innerHTML='<div class=\'cs-img-placeholder\'>Data Explorer: V2</div>'"
        />
      </div>

      <div class="cs-hero-summary reveal">
        <div class="cs-summary-col">
          <div class="cs-summary-card">
            <span class="cs-summary-title">
              <span class="en"
                >Product<span class="cs-summary-title-legend"
                  >mCUBE's Data Explorer</span
                ></span
              >
              <span class="fr"
                >Produit<span class="cs-summary-title-legend"
                  >Data Explorer de mCUBE</span
                ></span
              >
            </span>
            <p class="cs-summary-value">
              <span class="en"
                >mCUBE is a precision oncology platform. It aggregates
                multi-omic cancer data into a unified resource, giving R&D teams
                a high-resolution view of disease biology. The Data Explorer is
                mCUBE's discovery layer: where researchers search, filter, and
                evaluate omic datasets.</span
              >
              <span class="fr"
                >mCUBE est une plateforme d'oncologie de précision. Elle
                rassemble des données omiques en oncologie dans une ressource
                unifiée, offrant aux équipes R&D une lecture fine de la biologie
                tumorale. Le Data Explorer est la porte d'entrée de mCUBE :
                l'espace où les chercheurs explorent, filtrent et évaluent les
                datasets omiques.</span
              >
            </p>
          </div>
          <div class="cs-summary-card">
            <span class="cs-summary-title">
              <span class="en">Details</span>
              <span class="fr">Détails</span>
            </span>
            <div class="cs-summary-details">
              <div class="cs-summary-item">
                <p class="cs-summary-value">
                  Product Designer ∙ Frontend Engineer
                </p>
                <span class="heading-label">
                  <span class="en">Role</span>
                  <span class="fr">Rôle</span>
                </span>
              </div>
              <div class="cs-summary-item">
                <p class="cs-summary-value">
                  Figma ∙ FigJam ∙ React.js ∙ ReScript
                </p>
                <span class="heading-label">
                  <span class="en">Tools / Stack</span>
                  <span class="fr">Outils / Stack</span>
                </span>
              </div>
              <div class="cs-summary-item">
                <p class="cs-summary-value">
                  <span class="en"
                    >1 PM ∙ 1 designer (me) ∙ 2 front-end engineers (incl. me) ∙
                    1 back-end engineer ∙ 3 domain experts</span
                  >
                  <span class="fr"
                    >1 PM ∙ 1 designeuse (moi) ∙ 2 développeurs front-end (dont
                    moi) ∙ 1 développeur back-end ∙ 3 experts métier</span
                  >
                </p>
                <span class="heading-label">
                  <span class="en">Team</span>
                  <span class="fr">Équipe</span>
                </span>
              </div>
              <div class="cs-summary-item">
                <p class="cs-summary-value">
                  <span class="en"
                    >Design of the whole explorer. In code: the new layout
                    (filter sidebar, updated components, restructured table),
                    the detail panel and saved datasets. The other front-end
                    engineer built the rest.</span
                  >
                  <span class="fr"
                    >Design de l'ensemble du Data Explorer. Côté code : la
                    nouvelle structure (sidebar de filtres, mise à jour des
                    composants, restructuration du tableau), le panneau de
                    détails et les datasets sauvegardés. L'autre développeur
                    front-end a construit le reste.</span
                  >
                </p>
                <span class="heading-label">
                  <span class="en">My part</span>
                  <span class="fr">Ma part</span>
                </span>
              </div>
              <div class="cs-summary-item">
                <p class="cs-summary-value en">
                  Product Strategy ∙ Workshop Facilitation ∙ Prototyping ∙
                  Information Architecture ∙ Front-end development
                </p>
                <p class="cs-summary-value fr">
                  Stratégie produit ∙ Animation de workshop ∙ Prototypage ∙
                  Architecture de l'information ∙ Développement Front-end
                </p>
                <span class="heading-label">Scope</span>
              </div>
            </div>
          </div>
        </div>
        <div class="cs-summary-col">
          <div class="cs-summary-card">
            <div class="cs-summary-details">
              <div class="cs-summary-item">
                <span class="cs-summary-title">
                  <span class="en">Problem</span>
                  <span class="fr">Problème</span>
                </span>
                <p class="cs-summary-value">
                  <span class="en"
                    >The V1 explorer exposed only a fraction of the available
                    data, with no way to search by content, no structured
                    filters, and no context on what a dataset contained.</span
                  >
                  <span class="fr"
                    >La version 1 du Data Explorer ne donnait accès qu'à une
                    fraction des données disponibles, sans recherche par
                    contenu, sans filtres structurés, et sans aucun contexte sur
                    ce que contenait un dataset.</span
                  >
                </p>
              </div>
              <div class="cs-summary-item">
                <span class="cs-summary-title">
                  <span class="en">Solution</span>
                  <span class="fr">Solution</span>
                </span>
                <p class="cs-summary-value">
                  <span class="en"
                    >I redesigned the Data Explorer from the ground up, turning
                    a limited, technically labeled list into a fully searchable
                    discovery space covering 100% of Epigene's omic database.</span
                  >
                  <span class="fr"
                    >J'ai repensé le Data Explorer de fond en comble,
                    transformant une liste restreinte aux labels techniques en
                    un espace de découverte couvrant l'intégralité de la base de
                    données omiques d'Epigene.</span
                  >
                </p>
              </div>
              <div class="cs-summary-item">
                <span class="cs-summary-title">
                  <span class="en">Result</span>
                  <span class="fr">Résultat</span>
                </span>
                <p class="cs-summary-value">
                  <span class="en"
                    >The redesign made the full scale of Epigene's database
                    visible and explorable for the first time: 10× more datasets
                    accessible, searchable by content rather than by memory.</span
                  >
                  <span class="fr">
                    La refonte a rendu l'intégralité de la base de données
                    d'Epigene visible et explorable pour la première fois : 10
                    fois plus de datasets accessibles, trouvables par contenu
                    plutôt que par mémorisation.</span
                  >
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <main class="cs-main">
      <section class="cs-section reveal" id="context">
        <h2 class="cs-section-heading">
          <span class="en">Context</span>
          <span class="fr">Contexte</span>
        </h2>
        <div class="cs-subsections">
          <div class="flex flex-col gap-y-2">
            <p class="cs-section-heading-legend">
              <span class="en">
                Epigene Labs had over <span class="text-accent"
                  >20,000 cancer omics datasets</span
                > in its database. <br /><span class="text-accent"
                  >Only 2,000 were visible</span
                > on the platform.
              </span>
              <span class="fr">
                Epigene Labs disposait de <span class="text-accent">
                  plus de 20&nbsp;000 datasets omiques en oncologie
                </span> dans sa base de données.<br /><span class="text-accent"
                  >Seulement 2&nbsp;000 étaient visibles</span
                >
                sur la plateforme.
              </span>
            </p>
            <div class="grid-2">
              <p class="en">
                The reason: the rest hadn't gone through the internal curation
                and review process, so they were kept out of reach.
                Scientifically, they still held value, but users never saw them.
                As the company scaled, this gap became a competitive liability:
                prospects were comparing mCUBE's data coverage to competitors
                and finding it lacking.
              </p>
              <p class="fr">
                La raison&nbsp;: les autres n'avaient pas encore été soumis au
                processus interne de curation et de validation, ils restaient
                donc inaccessibles. Scientifiquement, ils avaient de la valeur,
                mais les utilisateurs ne les voyaient jamais. À mesure que la
                société se développait, cet écart devenait un handicap
                commercial&nbsp;: les prospects comparaient la couverture data
                de mCUBE à celle des concurrents et la trouvaient insuffisante.
              </p>
              <p class="en">
                This feature was part of a larger business pivot: showcasing the
                richness of Epigene's database as a core value proposition. When
                the request came to integrate unreviewed datasets, the PM and I
                saw it as an opportunity to go further. Rather than patching the
                existing interface, we used this moment to rethink the Data
                Explorer entirely, aligning the design with the new strategic
                direction.
              </p>
              <p class="fr">
                Cette feature s'inscrit dans un projet plus large&nbsp;: mettre
                en avant la richesse de la base de données d'Epigene comme
                proposition de valeur centrale. Quand la demande d'intégrer les
                datasets non validés est arrivée, le PM et moi y avons vu une
                opportunité d'aller plus loin. Plutôt que de corriger
                l'interface existante, nous avons saisi ce moment pour repenser
                entièrement le Data Explorer, en alignant le design avec la
                nouvelle orientation stratégique.
              </p>
            </div>
          </div>
          <div class="cs-section-content">
            <div class="cs-de-scale-band" data-scale>
              <div class="cs-de-scale-col" data-side="before">
                <p class="cs-label">
                  <span class="en">Before</span>
                  <span class="fr">Avant</span>
                </p>
                <div class="cs-de-scale-grid" aria-hidden="true">
                  {cells.map((i) => <span class={i < 10 ? "on" : ""} />)}
                </div>
                <p class="cs-de-scale-num">
                  <span class="en" data-count="2000" data-locale="en-US"
                    >2,000</span
                  >
                  <span class="fr" data-count="2000" data-locale="fr-FR"
                    >2&nbsp;000</span
                  >
                </p>
                <p class="cs-de-scale-cap">
                  <span class="en"
                    >curated datasets, the catalog the explorer was built for</span
                  >
                  <span class="fr"
                    >datasets curés, le catalogue pour lequel l'explorer avait
                    été conçu</span
                  >
                </p>
              </div>
              <div class="cs-de-scale-mid">
                <p class="cs-de-scale-x">10×</p>
                <p class="cs-de-scale-cap">
                  <span class="en">more datasets to handle</span>
                  <span class="fr">de datasets à accueillir</span>
                </p>
              </div>
              <div class="cs-de-scale-col" data-side="after">
                <p class="cs-label">
                  <span class="en">New data strategy</span>
                  <span class="fr">Nouvelle stratégie data</span>
                </p>
                <div class="cs-de-scale-grid" aria-hidden="true">
                  {cells.map(() => <span class="on" />)}
                </div>
                <p class="cs-de-scale-num">
                  <span
                    class="en"
                    data-count="20000"
                    data-locale="en-US"
                    data-suffix="+">20,000+</span
                  >
                  <span
                    class="fr"
                    data-count="20000"
                    data-locale="fr-FR"
                    data-suffix="+">20&nbsp;000+</span
                  >
                </p>
                <p class="cs-de-scale-cap">
                  <span class="en"
                    >datasets made available, unreviewed included</span
                  >
                  <span class="fr"
                    >datasets rendus disponibles, non validés compris</span
                  >
                </p>
              </div>
            </div>
            <p class="cs-section-subheading text-align-center">
              <span class="en"
                >An explorer <span class="text-accent"
                  >built for 2,000 curated datasets
                </span><span class="cs-accent">now had to handle 20,000+.</span
                ></span
              >
              <span class="fr"
                >Un explorer <span class="text-accent"
                  >pensé pour 2&nbsp;000 datasets curés</span
                >
                <span class="cs-accent"
                  >devait désormais en accueillir plus de 20&nbsp;000.</span
                ></span
              >
            </p>
          </div>
          <div class="cs-de-timeline" data-timeline>
            <ol class="cs-de-timeline-cards">
              {
                steps.map((s, i) => (
                  <li class="cs-de-timeline-card" style={`--i:${i}`}>
                    <div class="cs-de-timeline-card-top">
                      <span class="cs-de-timeline-icon" aria-hidden="true">
                        <Icon name={s.icon} />
                      </span>
                    </div>
                    <h3 class="cs-de-timeline-title">
                      <span class="en">{s.en.title}</span>
                      <span class="fr">{s.fr.title}</span>
                    </h3>
                    <p class="cs-de-timeline-text">
                      <span class="en">{s.en.text}</span>
                      <span class="fr">{s.fr.text}</span>
                    </p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>
      <section class="cs-section reveal" id="problem">
        <h2 class="cs-section-heading">
          <span class="en">Problem</span>
          <span class="fr">Problème</span>
        </h2>
        <div class="cs-subsections">
          <div class="grid-2 items-baseline">
            <p class="cs-section-heading-legend">
              <span class="en"
                >The explorer relied on users <span class="text-accent"
                  >already knowing what they were looking for</span
                >, an approach that <span class="text-accent"
                  >couldn't scale with the database</span
                >.</span
              >
              <span class="fr"
                >Le Data Explorer reposait sur des utilisateurs qui <span
                  class="text-accent">savaient déjà ce qu'ils cherchaient</span
                >, une approche qui <span class="text-accent"
                  >ne pouvait pas suivre la croissance de la base de données</span
                >.</span
              >
            </p>
            <div>
              <p class="en">
                The product was repositioning around the richness of its data,
                but the interface could neither show that richness nor help
                anyone find their way through it.
              </p>
              <p class="fr">
                Le produit se repositionnait autour de la richesse de ses
                données, mais l'interface ne permettait ni de la montrer, ni de
                s'y retrouver.
              </p>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="cs-de-needs-intro">
              <h3 class="cs-subsection-subheading text-align-center">
                <span class="en">The need for a redesign</span>
                <span class="fr">la nécessité d'une refonte</span>
              </h3>
              <p class="en text-align-center">
                The Data Explorer had been built for a small catalog of curated
                datasets. As the database grew, that architecture limited both
                what users could discover and how the product could be
                positioned commercially.
              </p>
              <p class="fr text-align-center">
                Le Data Explorer avait été conçu pour un catalogue restreint de
                datasets curés. À mesure que la base de données grandissait,
                cette architecture limitait autant la découverte côté
                utilisateurs que le positionnement commercial du produit.
              </p>
            </div>
            <div class="cs-de-needs" data-needs>
              <figure class="cs-de-needs-stage">
                <div class="cs-de-needs-shot">
                  <img
                    loading="lazy"
                    decoding="async"
                    width="2000"
                    height="1427"
                    src="/assets/data-explorer-context-needs.webp"
                    alt="Data Explorer V1: dataset counters above a table of datasets named by technical IDs"
                  />
                  <span class="cs-de-needs-spot" aria-hidden="true"></span>
                </div>
                <figcaption class="cs-de-needs-notes">
                  <p class="cs-de-needs-note" data-note="business">
                    <span class="en"
                      >The counters showed reviewed datasets only, a fraction of
                      the database.</span
                    >
                    <span class="fr"
                      >Les compteurs n'affichaient que les datasets validés, une
                      fraction de la base.</span
                    >
                  </p>
                  <p class="cs-de-needs-note" data-note="users">
                    <span class="en"
                      >Datasets named by technical IDs only: no title, no
                      description.</span
                    >
                    <span class="fr"
                      >Des datasets nommés par leur seul identifiant
                      technique&nbsp;: ni titre, ni description.</span
                    >
                  </p>
                </figcaption>
              </figure>
              <div class="cs-de-needs-cards">
                <article class="cs-de-needs-card" data-need="business">
                  <span class="heading-label">
                    <span class="en">Business need</span>
                    <span class="fr">Besoin business</span>
                  </span>
                  <h4 class="cs-de-needs-title">
                    <span class="en">Show the full scale</span>
                    <span class="fr">Montrer toute l'échelle</span>
                  </h4>
                  <p class="cs-de-needs-text">
                    <span class="en"
                      >A platform that reflects the real size of the database,
                      and holds up when prospects compare data coverage with
                      competitors.</span
                    >
                    <span class="fr"
                      >Une plateforme qui reflète la taille réelle de la base,
                      et qui tient la comparaison quand les prospects évaluent
                      la couverture data face aux concurrents.</span
                    >
                  </p>
                </article>
                <article class="cs-de-needs-card" data-need="users">
                  <span class="heading-label">
                    <span class="en">Researchers need</span>
                    <span class="fr">Besoin des chercheurs</span>
                  </span>
                  <h4 class="cs-de-needs-title">
                    <span class="en">Make discovery easier</span>
                    <span class="fr">Faciliter la découverte</span>
                  </h4>
                  <p class="cs-de-needs-text">
                    <span class="en"
                      >A way to find the right datasets by what they contain,
                      not by technical identifiers they'd have to know in
                      advance.</span
                    >
                    <span class="fr"
                      >Pouvoir trouver les bons datasets par leur contenu, et
                      non par des identifiants techniques à connaître à
                      l'avance.</span
                    >
                  </p>
                </article>
              </div>
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <h3 class="cs-subsection-subheading text-align-center">
              <span class="en">User interviews</span>
              <span class="fr">Interviews utilisateurs</span>
            </h3>
            <p class="en text-align-center">
              User interviews surfaced several blockers in the V1 explorer.
            </p>
            <p class="fr text-align-center">
              Les interviews utilisateurs ont fait ressortir plusieurs points de
              blocage dans le Data Explorer V1.
            </p>
            <div class="cs-de-interviews" data-interviews>
              <article class="cs-de-quote">
                <p class="heading-label">
                  <span class="en">Filters</span>
                  <span class="fr">Filtres</span>
                </p>
                <blockquote class="cs-de-quote-text">
                  <span class="cs-de-quote-dots" aria-hidden="true"
                    ><span></span><span></span><span></span></span
                  >
                  <p>
                    <span class="en"
                      >“There are way too many filters, and way too many values
                      in each one.”</span
                    >
                    <span class="fr"
                      >«&nbsp;Il y a beaucoup trop de filtres, et beaucoup trop
                      de valeurs dans chacun.&nbsp;»</span
                    >
                  </p>
                </blockquote>
                <div class="cs-de-quote-take">
                  <div>
                    <p class="cs-de-quote-label">
                      <span class="en">What we took from it</span>
                      <span class="fr">Ce qu'on en retient</span>
                    </p>
                    <p class="cs-de-quote-insight">
                      <span class="en"
                        >The volume of filters and values overwhelms users.</span
                      >
                      <span class="fr"
                        >Le volume de filtres et de valeurs submerge les
                        utilisateurs.</span
                      >
                    </p>
                  </div>
                </div>
              </article>
              <article class="cs-de-quote">
                <p class="heading-label">
                  <span class="en">Filters</span>
                  <span class="fr">Filtres</span>
                </p>
                <blockquote class="cs-de-quote-text">
                  <span class="cs-de-quote-dots" aria-hidden="true"
                    ><span></span><span></span><span></span></span
                  >
                  <p>
                    <span class="en"
                      >“I don't always understand what each filter means, the
                      terms are too scientific for me.”</span
                    >
                    <span class="fr"
                      >«&nbsp;Je ne comprends pas toujours à quoi correspond
                      chaque filtre, les termes sont trop scientifiques pour
                      moi.&nbsp;»</span
                    >
                  </p>
                </blockquote>
                <div class="cs-de-quote-take">
                  <div>
                    <p class="cs-de-quote-label">
                      <span class="en">What we took from it</span>
                      <span class="fr">Ce qu'on en retient</span>
                    </p>
                    <p class="cs-de-quote-insight">
                      <span class="en"
                        >Scientific terminology isn't accessible to every
                        profile.</span
                      >
                      <span class="fr"
                        >La terminologie scientifique n'est pas accessible à
                        tous les profils.</span
                      >
                    </p>
                  </div>
                </div>
              </article>
              <article class="cs-de-quote">
                <p class="heading-label">
                  <span class="en">Filters</span>
                  <span class="fr">Filtres</span>
                </p>
                <blockquote class="cs-de-quote-text">
                  <span class="cs-de-quote-dots" aria-hidden="true"
                    ><span></span><span></span><span></span></span
                  >
                  <p>
                    <span class="en"
                      >“I can't find the filters I use most often.”</span
                    >
                    <span class="fr"
                      >«&nbsp;Je ne retrouve pas les filtres que j'utilise le
                      plus souvent.&nbsp;»</span
                    >
                  </p>
                </blockquote>
                <div class="cs-de-quote-take">
                  <div>
                    <p class="cs-de-quote-label">
                      <span class="en">What we took from it</span>
                      <span class="fr">Ce qu'on en retient</span>
                    </p>
                    <p class="cs-de-quote-insight">
                      <span class="en"
                        >Frequently used filters aren't easy to reach.</span
                      >
                      <span class="fr"
                        >Les filtres les plus utilisés ne sont pas faciles
