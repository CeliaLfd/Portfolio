---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";

/* Photos live in one subfolder per theme: src/assets/fun/city/, src/assets/fun/landscape/.
   The folder name is the theme used by the filter. */
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/fun/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

const themes = [
  { id: "all", en: "All", fr: "Tout" },
  { id: "city", en: "City", fr: "Ville" },
  { id: "landscape", en: "Landscape", fr: "Paysage" },
];

const themeOf = (path: string) => path.split("/").slice(-2, -1)[0];
const fileName = (path: string) => path.split("/").pop()!;

const toAlt = (path: string) => {
  const name = path
    .split("/")
    .pop()!
    .replace(/\.[^.]+$/, "")
    .replace(/^\d+[-_ ]*/, "")
    .replace(/[-_]+/g, " ")
    .trim();
  // Camera file names (DSCF0136, IMG_1234…) say nothing: generic alt instead
  if (!name || /^[a-z_]{2,5}\s?\d+$/i.test(name)) return "";
  return name.charAt(0).toUpperCase() + name.slice(1);
};

const photos = await Promise.all(
  Object.entries(files)
    // File name order (camera numbers), themes mixed in the "All" view
    .sort(([a], [b]) =>
      fileName(a).localeCompare(fileName(b), undefined, { numeric: true }),
    )
    .map(async ([path, mod], i) => {
      const src = mod.default;
      // Larger version for the lightbox, still compressed
      const full = await getImage({
        src,
        width: Math.min(src.width, 2400),
        format: "webp",
        quality: 85,
      });
      const alt = toAlt(path) || `Photograph by Célia Lafond, ${i + 1}`;
      return {
        src,
        alt,
        full: full.src,
        ratio: src.width / src.height,
        theme: themeOf(path),
      };
    }),
);
---

<Layout
  title="Through my lens | Célia Lafond"
  description="Photography by Célia Lafond."
  noindex
>
  <main id="main" class="page container flex flex-col gap-6">
    <h1 class="reveal cs-section-heading-legend text-accent text-align-center">
      <span class="en">Through my lens</span>
      <span class="fr">À travers mon objectif</span>
    </h1>
    <div class="flex flex-col gap-4">
      <!-- Theme filter: plain radios, filtering done in CSS (fun.css, :has) -->
      <fieldset class="fun-filter">
        <legend class="sr-only">
          <span class="en">Filter photos by theme</span>
          <span class="fr">Filtrer les photos par thème</span>
        </legend>
        {
          themes.map((t, i) => (
            <label class="fun-filter-option">
              <input
                type="radio"
                name="fun-theme"
                value={t.id}
                checked={i === 0}
              />
              <span class="en">{t.en}</span>
              <span class="fr">{t.fr}</span>
            </label>
          ))
        }
      </fieldset>
      <ul class="fun-grid">
        {
          photos.map((photo, i) => (
            <li
              class="fun-photo reveal"
              data-theme={photo.theme}
              style={`--r:${photo.ratio.toFixed(4)}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[480, 800, 1200, 1600]}
                sizes="(max-width: 749px) 100vw, (max-width: 1199px) 50vw, 34vw"
                format="webp"
                quality={80}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
                data-lightbox
                data-full={photo.full}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</Layout>
