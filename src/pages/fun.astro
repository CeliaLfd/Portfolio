---
/* ============================================
   FUN: private photo page (/fun)
   Not linked anywhere on the site, noindex + nofollow.
   Its photos are the only images processed by astro:assets: vercel.json
   sends X-Robots-Tag: noindex on every image in /_astro/.
   Photos: drop them in src/assets/fun/ (JPG, PNG, WebP or AVIF).
   Order = file name order (prefix them 01-, 02-…).
   Alt text = file name without the number and extension
   (01-lyon-at-dusk.jpg → "Lyon at dusk").
============================================ */
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/fun/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

const toAlt = (path: string) => {
  const name = path
    .split("/")
    .pop()!
    .replace(/\.[^.]+$/, "")
    .replace(/^\d+[-_ ]*/, "")
    .replace(/[-_]+/g, " ")
    .trim();
  // Camera file names (DSCF0136, IMG_1234…) say nothing: generic alt instead
  if (!name || /^[a-z_]{2,5}\s?\d+$/i.test(name)) return "";
  return name.charAt(0).toUpperCase() + name.slice(1);
};

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(async ([path, mod], i) => {
      const src = mod.default;
      // Larger version for the lightbox, still compressed
      const full = await getImage({
        src,
        width: Math.min(src.width, 2400),
        format: "webp",
        quality: 85,
      });
      const alt = toAlt(path) || `Photograph by Célia Lafond, ${i + 1}`;
      return { src, alt, full: full.src, ratio: src.width / src.height };
    }),
);
---

<Layout
  title="Fun | Célia Lafond"
  description="Photography by Célia Lafond."
  noindex
>
  <div class="cs-page fun-page">
    <!-- <header class="fun-head reveal">
      <h1 class="cs-page-title">
        <span class="en">[Title]</span>
        <span class="fr">[Titre]</span>
      </h1>
      <p class="fun-intro">
        <span class="en">[Intro sentence]</span>
        <span class="fr">[Phrase d'intro]</span>
      </p>
    </header> -->

    <main>
      <ul class="fun-grid">
        {
          photos.map((photo, i) => (
            <li class="fun-photo" style={`--r:${photo.ratio.toFixed(4)}`}>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[480, 800, 1200, 1600]}
                sizes="(max-width: 749px) 100vw, (max-width: 1199px) 50vw, 34vw"
                format="webp"
                quality={80}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
                data-lightbox
                data-full={photo.full}
              />
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</Layout>
