---
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/fun/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
);

const toAlt = (path: string) => {
  const name = path
    .split("/")
    .pop()!
    .replace(/\.[^.]+$/, "")
    .replace(/^\d+[-_ ]*/, "")
    .replace(/[-_]+/g, " ")
    .trim();
  // Camera file names (DSCF0136, IMG_1234…) say nothing: generic alt instead
  if (!name || /^[a-z_]{2,5}\s?\d+$/i.test(name)) return "";
  return name.charAt(0).toUpperCase() + name.slice(1);
};

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
    .map(async ([path, mod], i) => {
      const src = mod.default;
      // Larger version for the lightbox, still compressed
      const full = await getImage({
        src,
        width: Math.min(src.width, 2400),
        format: "webp",
        quality: 85,
      });
      const alt = toAlt(path) || `Photograph by Célia Lafond, ${i + 1}`;
      return { src, alt, full: full.src, ratio: src.width / src.height };
    }),
);
---

<Layout
  title="Through my lens | Célia Lafond"
  description="Photography by Célia Lafond."
  noindex
>
  <div class="page container flex flex-col gap-6">
    <h1 class="reveal cs-section-heading-legend text-accent text-align-center">
      <span class="en">Through my lens</span>
      <span class="fr">À travers mon objectif</span>
    </h1>
    <main>
      <ul class="fun-grid">
        {
          photos.map((photo, i) => (
            <li
              class="fun-photo reveal"
              style={`--r:${photo.ratio.toFixed(4)}`}
            >
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[480, 800, 1200, 1600]}
                sizes="(max-width: 749px) 100vw, (max-width: 1199px) 50vw, 34vw"
                format="webp"
                quality={80}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
                data-lightbox
                data-full={photo.full}
              />
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</Layout>
