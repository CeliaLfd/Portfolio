---
import CaseStudyCard from "../components/CaseStudyCard.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Célia Lafond — Senior Product Designer & Frontend Engineer">
  <main>
    <section class="home-hero">
      <div class="container">
        <h1 class="reveal">
          <span class="en"
            >I'm Célia, a Product&nbsp;Designer <br />
            <span class="hero-title-embed">who engineers.</span>
          </span>
          <span class="fr">
            Je suis Célia, Product&nbsp;Designer <br />
            <span class="hero-title-embed">qui code.</span>
          </span>
        </h1>
        <!-- <p class="home-hero-intro reveal">
          <span class="en">
            Senior Product Designer &amp; Front-end Engineer based in Lyon,
            France. For 10 years I've designed and built B2B products: 4 years
            at Epigene Labs on a cancer genomics platform, and 6 years at Link
            Value on SaaS products, design systems and internal tools.
          </span>
          <span class="fr">
            Senior Product Designer &amp; Front-end Engineer basée à Lyon.
            Depuis 10 ans, je conçois et développe des produits B2B : 4 ans chez
            Epigene Labs sur une plateforme de génomique du cancer, et 6 ans
            chez Link Value sur des produits SaaS, des design systems et des
            outils internes.
          </span>
        </p> -->
      </div>
    </section>

    <section class="cs-grid-section">
      <div class="container-lg">
        <div class="cs-grid">
          <CaseStudyCard
            href="/epigene-data-explorer"
            image="/assets/cover-data-explorer.webp"
            loading="eager"
            imageAlt="Data Explorer redesign"
            titleEn="Redesigning the Data Explorer for 10× more datasets"
            titleFr="Repenser le Data Explorer pour 10 fois plus de datasets"
            meta="Epigene Labs · 2025"
            contextEn="Turning a limited list of untitled, undescribed datasets into a discovery space where researchers can explore 20,000+ datasets."
            contextFr="Transformer une liste limitée de datasets sans titre ni description en un espace de découverte où les chercheurs explorent plus de 20 000 datasets."
            imageVariant="data-explorer"
            backgroundColor="#6661D6"
          />
          <CaseStudyCard
            href="/epigene-design-system"
            image="/assets/cover-design-system.webp"
            imageAlt="mCUBE design system"
            titleEn="Building mCUBE's first design system, from audit to code"
            titleFr="Construire le premier design system de mCUBE, de l'audit au code"
            meta="Epigene Labs · 2022 - 2026"
            contextEn="Creating the product's first design system, a single source of truth for design and code, to bring consistency to every screen and autonomy to the team."
            contextFr="Créer le premier design system du produit, source unique de vérité entre design et code, pour une expérience cohérente d'un écran à l'autre et des équipes plus autonomes."
            imageVariant="design-system"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
