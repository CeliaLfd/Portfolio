---
import CaseStudyCard from "../components/CaseStudyCard.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Célia Lafond — Product Designer & Frontend Engineer">
  <main>
    <section class="home-hero">
      <div class="container">
        <h1 class="reveal">
          <span class="en"
            >I'm Célia, a Product&nbsp;Designer <br />
            <span class="hero-title-embed">who engineers.</span>
          </span>
          <span class="fr">
            Je suis Célia, Product&nbsp;Designer <br />
            <span class="hero-title-embed">qui code.</span>
          </span>
        </h1>
      </div>
    </section>

    <section class="cs-grid-section">
      <div class="container-lg">
        <div class="cs-grid">
          <CaseStudyCard
            href="/epigene-data-explorer"
            image="/assets/cover-data-explorer.png"
            imageAlt="Data Explorer redesign"
            titleEn="Data Explorer Redesign"
            titleFr="Refonte du Data Explorer"
            meta="Epigene Labs · 2025"
            imageVariant="data-explorer"
            backgroundColor="#6661D6"
          />
          <CaseStudyCard
            href="/epigene-design-system"
            image="/assets/cover-design-system.png"
            imageAlt="mCUBE login screen"
            titleEn="Design System"
            titleFr=" Design System"
            meta="Epigene Labs · 2022 - 2026"
            imageVariant="design-system"
          />
        </div>
      </div>
    </section>
  </main>
</Layout>
