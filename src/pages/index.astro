---
import Layout from '../layouts/Layout.astro'
---
<Layout title="Célia Lafond — Product Designer & Frontend Engineer">
  <main>

    <section class="home-hero">
      <div class="container">
        <h1 class="reveal">
          <span class="en">I'm Célia, a Product Designer <em>who engineers.</em></span>
          <span class="fr">Je suis Célia, Product Designer <em>qui code.</em></span>
        </h1>
      </div>
    </section>

    <section class="cs-grid-section">
      <div class="container">
        <div class="cs-grid">

          <a href="/epigene-design-system" class="cs-card reveal">
            <div class="cs-card-image">
              <img
                src="/_assets/hero-login.jpg"
                alt="mCUBE login screen"
                onerror="this.style.display='none'"
              >
            </div>
            <div class="cs-card-info">
              <h2 class="cs-card-title">
                <span class="en">Core Redesign & Design System</span>
                <span class="fr">Refonte & Design System</span>
              </h2>
              <p class="cs-card-meta">Epigene Labs &middot; 2022</p>
            </div>
          </a>

          <a href="/epigene-data-explorer" class="cs-card reveal">
            <div class="cs-card-image">
              <img
                src="/_assets/data-explorer-v2.jpg"
                alt="Data Explorer redesign"
                onerror="this.style.display='none'"
              >
            </div>
            <div class="cs-card-info">
              <h2 class="cs-card-title">
                <span class="en">Data Explorer Redesign</span>
                <span class="fr">Refonte du Data Explorer</span>
              </h2>
              <p class="cs-card-meta">Epigene Labs &middot; 2025</p>
            </div>
          </a>

        </div>
      </div>
    </section>

  </main>
</Layout>
