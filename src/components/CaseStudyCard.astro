---
interface Props {
  href?: string;
  image: string;
  video?: string;
  imageAlt: string;
  titleEn: string;
  titleFr: string;
  meta: string;
  contextEn?: string;
  contextFr?: string;
  imageVariant?: string;
  backgroundColor?: string;
  loading?: "lazy" | "eager";
  /* Case study page exists but is still being written: "Sneak peek" instead of "Read the case study" */
  preview?: boolean;
}

const {
  href,
  image,
  video,
  imageAlt,
  titleEn,
  titleFr,
  meta,
  contextEn,
  contextFr,
  imageVariant,
  backgroundColor,
  loading = "lazy",
  preview = false,
} = Astro.props;
---

<a {...href ? { href } : {}} class="cs-card reveal">
  <div
    class={`cs-card-image cs-hero-image ${imageVariant ? `cs-hero-image-${imageVariant}` : ""}`}
    style={backgroundColor ? { backgroundColor } : undefined}
  >
    {
      video ? (
        <video
          src={video}
          poster={image}
          data-placeholder={image}
          aria-label={imageAlt}
          data-play-on-view
          muted
          loop
          playsinline
          disablepictureinpicture
          disableRemotePlayback
          preload={loading === "eager" ? "auto" : "metadata"}
        />
      ) : (
        <img src={image} alt={imageAlt} loading={loading} decoding="async" onerror="this.style.display='none'" />
      )
    }
  </div>
  <div class="cs-card-info">
    <p class="cs-card-meta">{meta}</p>
    <h2 class="cs-card-title">
      <span class="en">{titleEn}</span>
      <span class="fr">{titleFr}</span>
    </h2>
    {
      contextEn && (
        <p class="cs-card-context">
          <span class="en">{contextEn}</span>
          <span class="fr">{contextFr}</span>
        </p>
      )
    }
    {
      href ? (
        <span class="cs-card-cta">
          {preview ? (
            <>
              <span class="en">Sneak peek</span>
              <span class="fr">Aperçu</span>
            </>
          ) : (
            <>
              <span class="en">Read the case study</span>
              <span class="fr">Lire le case study</span>
            </>
          )}
          <span aria-hidden="true">→</span>
        </span>
      ) : (
        <span class="cs-card-cta is-soon">
          <span class="en">Coming soon</span>
          <span class="fr">Bientôt</span>
        </span>
      )
    }
  </div>
  <div class="cs-cursor-label" aria-hidden="true">
    {
      href && preview ? (
        <>
          <span class="en">Sneak peek</span>
          <span class="fr">Aperçu</span>
        </>
      ) : href ? (
        <>
          <span class="en">View case study</span>
          <span class="fr">Voir le projet</span>
        </>
      ) : (
        <>
          <span class="en">Coming soon</span>
          <span class="fr">Bientôt</span>
        </>
      )
    }
  </div>
</a>
