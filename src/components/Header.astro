---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isAbout = path === "/about";
const isFun = path === "/fun";
// Work couvre la homepage et toutes les pages case study
const isWork = !isAbout && !isFun;
---

<header class="site-header">
  <a href="/" class="site-logo">CL</a>
  <nav class="site-nav">
    <a href="/" class:list={{ active: isWork }} aria-current={isWork ? "page" : undefined}>
      <span class="en">Work</span>
      <span class="fr">Projets</span>
    </a>
    <a href="/about" class:list={{ active: isAbout }} aria-current={isAbout ? "page" : undefined}>
      <span class="en">About</span>
      <span class="fr">À propos</span>
    </a>
    <a href="/fun" class:list={{ active: isFun }} aria-current={isFun ? "page" : undefined}>Fun</a>
    <a href="/assets/CeliaLafond_CV_EN.pdf?v=2" target="_blank" class="en">Resume</a>
    <a href="/assets/CeliaLafond_CV_FR.pdf?v=2" target="_blank" class="fr">CV</a>
  </nav>
  <div class="lang-toggle">
    <button data-lang="en" onclick="setLang('en')">EN</button>
    <span class="lang-sep">/</span>
    <button data-lang="fr" onclick="setLang('fr')">FR</button>
  </div>
</header>
