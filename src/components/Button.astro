---
import type { HTMLAttributes } from "astro/types";

/* Ink pill: a link when `href` is set, a button otherwise.
   Extra attributes (data-*, aria-*) go straight to the element. */
type Props = HTMLAttributes<"a"> & HTMLAttributes<"button">;

const { href, class: className, ...rest } = Astro.props;
const classes = ["btn", className].filter(Boolean).join(" ");
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes} {...rest}>
      <slot />
    </button>
  )
}
