---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  strokeWidth?: number;
  class?: string;
}

const { name, strokeWidth = 1.75, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
