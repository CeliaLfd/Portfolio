---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Portfolio of Célia Lafond, Senior Product Designer & Frontend Engineer.' } = Astro.props
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="lang-en">
  <Header />
  <slot />
  <Footer />
  <script src="/main.js"></script>
</body>
</html>
