---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/style.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Portfolio of Célia Lafond, Senior Product Designer & Frontend Engineer.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="lang-en">
    <Header />
    <slot />
    <Footer />
    <div class="img-modal" id="imgModal" aria-hidden="true">
      <button class="img-modal-close" id="imgModalClose" aria-label="Close">
        <svg viewBox="0 0 24 24"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line></svg
        >
      </button>
      <img id="imgModalImg" src="" alt="" />
    </div>

    <script src="/main.js" is:inline></script>
  </body>
</html>
